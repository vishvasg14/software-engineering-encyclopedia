{
    "type": "record",
    "name": "Order",
    "namespace": "com.example.orders",
    "fields": [
        { "name": "id", "type": "string" },
        { "name": "customerId", "type": "string" },
        { "name": "amount", "type": "double" },
        { "name": "currency", "type": "string", "default": "USD" },
        { "name": "createdAt", "type": "long", "logicalType": "timestamp-millis" }
    ]
}